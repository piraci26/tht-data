// =============================================================================
// THT Dual Scan — B-Xtrender (oscillator pane)  ·  v5
// =============================================================================
// Matches the v2 Combined design that you liked from the earlier screenshot:
//   · Teal/coral palette throughout (smoothed lines match histogram)
//   · Halo'd smoothed lines (4px halo + 2px line)
//   · Zero-cross dots restored
//   · Crossover diamonds
//   · Status table at top-right of the BXT pane
//   · Zero + dotted ±10 reference lines
//
// Apply together with "THT Dual Scan — FVB" on the price pane.
//
// Math identical to scan.py.
// =============================================================================
//@version=6
indicator("THT Dual Scan — B-Xtrender", "BXT", overlay = false, format = format.price, precision = 2)

// ─── INPUTS ──────────────────────────────────────────────────────────
shortFast = input.int(5,  "Short EMA fast",   minval = 1, group = "Short-term BXT")
shortSlow = input.int(20, "Short EMA slow",   minval = 1, group = "Short-term BXT")
shortRsi  = input.int(15, "Short RSI length", minval = 1, group = "Short-term BXT")
longRsi   = input.int(15, "Long RSI length",  minval = 1, group = "Long-term BXT")
smoothLen = input.int(5,  "Smoothing WMA",    minval = 1, group = "Smoothing")

showXover = input.bool(true, "Smoothed crossovers", group = "Display")
showFlips = input.bool(true, "Zero-cross dots",     group = "Display")
showHist  = input.bool(true, "Histogram",           group = "Display")
showHalo  = input.bool(true, "Halo on smoothed lines", group = "Display")
showTable = input.bool(true, "Status table",        group = "Display")

// Colors — teal/coral throughout (matches the screenshot you liked)
bullCol   = input.color(#26a69a, "Bull (histogram + smooth short)", group = "Colors")
bearCol   = input.color(#ef5350, "Bear (histogram + smooth long)",  group = "Colors")
amberCol  = input.color(#FFAA00, "Mixed/warning",                   group = "Colors")

// ─── CALCULATIONS ────────────────────────────────────────────────────
emaDiff      = ta.ema(close, shortFast) - ta.ema(close, shortSlow)
shortBxt     = ta.rsi(emaDiff, shortRsi) - 50
longBxt      = ta.wma(ta.rsi(close, longRsi) - 50, smoothLen)
shortSmooth  = ta.wma(shortBxt, smoothLen)

xoverUp   = ta.crossover (shortSmooth, longBxt)
xoverDown = ta.crossunder(shortSmooth, longBxt)

bxtFlipGreen = shortBxt > 0 and shortBxt[1] <= 0
bxtFlipRed   = shortBxt < 0 and shortBxt[1] >= 0

// Streak: bars in current sign regime
var int streak = 0
streak := math.sign(shortBxt) == math.sign(shortBxt[1]) ? streak + 1 : 1

// ─── PLOTS ───────────────────────────────────────────────────────────
// Histogram (saturated teal/coral)
histCol = shortBxt >= 0 ? color.new(bullCol, 25) : color.new(bearCol, 25)
plot(showHist ? shortBxt : na, "BXT Short Histogram",
     color = histCol, style = plot.style_columns)

// Smoothed lines with halos (same teal/coral as histogram)
plot(showHalo ? shortSmooth : na, "Smooth Short halo", color = color.new(bullCol, 70), linewidth = 4)
plot(shortSmooth, "Smooth Short", color = bullCol, linewidth = 2)
plot(showHalo ? longBxt : na, "Smooth Long halo", color = color.new(bearCol, 70), linewidth = 4)
plot(longBxt, "Smooth Long", color = bearCol, linewidth = 2)

// Reference lines
hline( 0,  "Zero", color = color.new(color.gray, 30), linestyle = hline.style_solid)
hline( 10, "+10",  color = color.new(color.gray, 70), linestyle = hline.style_dotted)
hline(-10, "−10",  color = color.new(color.gray, 70), linestyle = hline.style_dotted)

// Zero-cross flip dots
plotshape(showFlips and bxtFlipGreen ? 0 : na, "Bull Flip", shape.circle,
          location.absolute, color = bullCol, size = size.small)
plotshape(showFlips and bxtFlipRed   ? 0 : na, "Bear Flip", shape.circle,
          location.absolute, color = bearCol, size = size.small)

// Smoothed-line crossover diamonds (subtle confirmation signal)
plotshape(showXover and xoverUp   ? shortSmooth : na, "X-Up",   shape.diamond,
          location.absolute, color = bullCol, size = size.tiny)
plotshape(showXover and xoverDown ? shortSmooth : na, "X-Down", shape.diamond,
          location.absolute, color = bearCol, size = size.tiny)

// ─── ALERTS ─────────────────────────────────────────────────────────
alertcondition(bxtFlipGreen, "BXT crossed above zero",
    "{{ticker}} ({{interval}}) — BXT crossed above zero at {{close}}")
alertcondition(bxtFlipRed,   "BXT crossed below zero",
    "{{ticker}} ({{interval}}) — BXT crossed below zero at {{close}}")
alertcondition(xoverUp,   "BXT smoothed cross UP",
    "{{ticker}} ({{interval}}) — BXT smooth-short crossed above smooth-long at {{close}}")
alertcondition(xoverDown, "BXT smoothed cross DOWN",
    "{{ticker}} ({{interval}}) — BXT smooth-short crossed below smooth-long at {{close}}")

// ─── STATUS TABLE (top-right of BXT pane) ───────────────────────────
if showTable and barstate.islast
    var table tbl = table.new(position.top_right, 2, 4,
        bgcolor      = color.new(color.black, 80),
        border_color = color.new(color.gray, 70), border_width = 1,
        frame_color  = color.new(color.gray, 70), frame_width  = 1)

    table.cell(tbl, 0, 0, " REGIME ", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 0, shortBxt >= 0 ? " BULL " : " BEAR ",
               text_color = color.white, text_size = size.normal, text_halign = text.align_center,
               bgcolor = shortBxt >= 0 ? bullCol : bearCol)

    table.cell(tbl, 0, 1, " SHORT ", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 1, " " + str.tostring(shortBxt, "+#.##") + " ",
               text_color = shortBxt >= 0 ? bullCol : bearCol, text_size = size.normal,
               text_halign = text.align_right)

    table.cell(tbl, 0, 2, " LONG ",  text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 2, " " + str.tostring(longBxt, "+#.##") + " ",
               text_color = longBxt >= 0 ? bullCol : bearCol, text_size = size.normal,
               text_halign = text.align_right)

    table.cell(tbl, 0, 3, " STREAK ", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 3, " " + str.tostring(streak) + " bars ",
               text_color = color.white, text_size = size.normal, text_halign = text.align_right)
