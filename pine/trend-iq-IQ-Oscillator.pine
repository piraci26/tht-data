// =============================================================================
// trend-iq · IQ Oscillator  (separate-pane indicator)
// =============================================================================
// Momentum oscillator built from RSI of an EMA difference, with smoothed
// short and long lines, halo'd renders, zero-cross dots and crossover diamonds.
//
//   · Histogram: short-term oscillator value, teal/coral by sign
//   · Smooth Short: vivid lime, halo'd
//   · Smooth Long:  vivid red, halo'd
//   · Zero-cross dots
//   · Smoothed crossover diamonds
//   · Reference lines at 0, +10, -10
//   · Status table top-right (regime / short value / long value / streak bars)
//
// Apply alongside "trend-iq · IQ Bands" on the price pane for the full
// dual-flip signal set.
// =============================================================================
//@version=6
indicator("trend-iq · IQ Oscillator", "IQ Osc", overlay = false, format = format.price, precision = 2)

// ─── INPUTS ──────────────────────────────────────────────────────────
shortFast = input.int(5,  "Short EMA fast",   minval = 1, group = "Short-term Oscillator")
shortSlow = input.int(20, "Short EMA slow",   minval = 1, group = "Short-term Oscillator")
shortRsi  = input.int(15, "Short RSI length", minval = 1, group = "Short-term Oscillator")
longRsi   = input.int(15, "Long RSI length",  minval = 1, group = "Long-term Oscillator")
smoothLen = input.int(5,  "Smoothing WMA",    minval = 1, group = "Smoothing")

showXover = input.bool(true, "Smoothed crossovers",     group = "Display")
showFlips = input.bool(true, "Zero-cross dots",         group = "Display")
showHist  = input.bool(true, "Histogram",               group = "Display")
showHalo  = input.bool(true, "Halo on smoothed lines",  group = "Display")
showTable = input.bool(true, "Status table",            group = "Display")

// Colors
bullCol   = input.color(#26a69a, "Bull (histogram + dots)",         group = "Colors")
bearCol   = input.color(#ef5350, "Bear (histogram + dots)",         group = "Colors")
shortCol  = input.color(#00E676, "Smoothed short line (lime)",      group = "Colors")
longCol   = input.color(#FF5252, "Smoothed long line (bright red)", group = "Colors")
amberCol  = input.color(#FFAA00, "Mixed/warning",                   group = "Colors")

// ─── CALCULATIONS ────────────────────────────────────────────────────
emaDiff      = ta.ema(close, shortFast) - ta.ema(close, shortSlow)
shortBxt     = ta.rsi(emaDiff, shortRsi) - 50
longBxt      = ta.wma(ta.rsi(close, longRsi) - 50, smoothLen)
shortSmooth  = ta.wma(shortBxt, smoothLen)

xoverUp   = ta.crossover (shortSmooth, longBxt)
xoverDown = ta.crossunder(shortSmooth, longBxt)

oscFlipGreen = shortBxt > 0 and shortBxt[1] <= 0
oscFlipRed   = shortBxt < 0 and shortBxt[1] >= 0

// Streak: bars in current sign regime
var int streak = 0
streak := math.sign(shortBxt) == math.sign(shortBxt[1]) ? streak + 1 : 1

// ─── PLOTS ───────────────────────────────────────────────────────────
histCol = shortBxt >= 0 ? color.new(bullCol, 25) : color.new(bearCol, 25)
plot(showHist ? shortBxt : na, "Histogram",
     color = histCol, style = plot.style_columns)

plot(showHalo ? shortSmooth : na, "Smooth Short halo", color = color.new(shortCol, 70), linewidth = 4)
plot(shortSmooth, "Smooth Short", color = shortCol, linewidth = 2)
plot(showHalo ? longBxt : na, "Smooth Long halo", color = color.new(longCol, 70), linewidth = 4)
plot(longBxt, "Smooth Long", color = longCol, linewidth = 2)

hline( 0,  "Zero", color = color.new(color.gray, 30), linestyle = hline.style_solid)
hline( 10, "+10",  color = color.new(color.gray, 70), linestyle = hline.style_dotted)
hline(-10, "−10",  color = color.new(color.gray, 70), linestyle = hline.style_dotted)

plotshape(showFlips and oscFlipGreen ? 0 : na, "Bull Flip", shape.circle,
          location.absolute, color = bullCol, size = size.small)
plotshape(showFlips and oscFlipRed   ? 0 : na, "Bear Flip", shape.circle,
          location.absolute, color = bearCol, size = size.small)

plotshape(showXover and xoverUp   ? shortSmooth : na, "X-Up",   shape.diamond,
          location.absolute, color = bullCol, size = size.tiny)
plotshape(showXover and xoverDown ? shortSmooth : na, "X-Down", shape.diamond,
          location.absolute, color = bearCol, size = size.tiny)

// ─── ALERTS ─────────────────────────────────────────────────────────
alertcondition(oscFlipGreen, "IQ Oscillator crossed above zero",
    "{{ticker}} ({{interval}}) — IQ Oscillator crossed above zero at {{close}}")
alertcondition(oscFlipRed,   "IQ Oscillator crossed below zero",
    "{{ticker}} ({{interval}}) — IQ Oscillator crossed below zero at {{close}}")
alertcondition(xoverUp,   "IQ Oscillator smoothed cross UP",
    "{{ticker}} ({{interval}}) — IQ Oscillator smooth-short crossed above smooth-long at {{close}}")
alertcondition(xoverDown, "IQ Oscillator smoothed cross DOWN",
    "{{ticker}} ({{interval}}) — IQ Oscillator smooth-short crossed below smooth-long at {{close}}")

// ─── STATUS TABLE (top-right of oscillator pane) ────────────────────
if showTable and barstate.islast
    var table tbl = table.new(position.top_right, 2, 4,
        bgcolor      = color.new(color.black, 80),
        border_color = color.new(color.gray, 70), border_width = 1,
        frame_color  = color.new(color.gray, 70), frame_width  = 1)

    table.cell(tbl, 0, 0, " REGIME ", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 0, shortBxt >= 0 ? " BULL " : " BEAR ",
               text_color = color.white, text_size = size.normal, text_halign = text.align_center,
               bgcolor = shortBxt >= 0 ? bullCol : bearCol)

    table.cell(tbl, 0, 1, " SHORT ", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 1, " " + str.tostring(shortBxt, "+#.##") + " ",
               text_color = shortBxt >= 0 ? bullCol : bearCol, text_size = size.normal,
               text_halign = text.align_right)

    table.cell(tbl, 0, 2, " LONG ",  text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 2, " " + str.tostring(longBxt, "+#.##") + " ",
               text_color = longBxt >= 0 ? bullCol : bearCol, text_size = size.normal,
               text_halign = text.align_right)

    table.cell(tbl, 0, 3, " STREAK ", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 3, " " + str.tostring(streak) + " bars ",
               text_color = color.white, text_size = size.normal, text_halign = text.align_right)
