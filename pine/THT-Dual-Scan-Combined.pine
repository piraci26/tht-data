// =============================================================================
// THT Dual Scan — Combined (FVB + B-Xtrender)  ·  v2 visual rewrite
// =============================================================================
// Single-script combined indicator. Plots FVB cloud + basis on the price pane
// and BXT histogram + smoothed lines in a separate oscillator pane.
//
// Math identical to scan.py (https://github.com/piraci26/tht-data).
// Visuals tuned for legibility — bolder cloud, regime-colored bands, thicker
// signal lines, prominent flip markers, optional candle coloring, clean table.
// =============================================================================
//@version=6
indicator("THT Dual Scan", "DualScan", overlay = false, format = format.price, precision = 2,
          max_lines_count = 500, max_labels_count = 500)

// ─── INPUTS ──────────────────────────────────────────────────────────
fvbLen   = input.int(20,   "FVB Length",            minval = 2, group = "Fair Value Bands")
fvbMult  = input.float(2.0, "FVB StdDev Multiplier", minval = 0.0, step = 0.1, group = "Fair Value Bands")

shortFast = input.int(5,  "Short EMA fast",   minval = 1, group = "B-Xtrender")
shortSlow = input.int(20, "Short EMA slow",   minval = 1, group = "B-Xtrender")
shortRsi  = input.int(15, "Short RSI length", minval = 1, group = "B-Xtrender")
longRsi   = input.int(15, "Long RSI length",  minval = 1, group = "B-Xtrender")
smoothLen = input.int(5,  "Smoothing WMA",    minval = 1, group = "B-Xtrender")

// Display toggles
showCloud   = input.bool(true,  "FVB cloud",                    group = "Display")
showBands   = input.bool(true,  "FVB band edges (regime tint)", group = "Display")
showFlips   = input.bool(true,  "Flip markers (FVB + BXT)",     group = "Display")
showDual    = input.bool(true,  "DUAL FLIP triangles",          group = "Display")
showXover   = input.bool(true,  "BXT smoothed crossovers",      group = "Display")
showBgPane  = input.bool(true,  "Tint BXT pane background",     group = "Display")
colorBars   = input.bool(false, "Color price bars by regime (subtle)", group = "Display")
showTable   = input.bool(true,  "Status table (top right)",     group = "Display")

// Colors (defaults tuned for both light and dark)
bullCol   = input.color(#26a69a, "Bull",       group = "Colors")
bearCol   = input.color(#ef5350, "Bear",       group = "Colors")
basisCol  = input.color(#2962FF, "Basis line", group = "Colors")
amberCol  = input.color(#FFAA00, "Mixed/warning", group = "Colors")

// ─── FVB ─────────────────────────────────────────────────────────────
basis  = ta.sma(close,  fvbLen)
sd     = ta.stdev(close, fvbLen)
upper  = basis + fvbMult * sd
lower  = basis - fvbMult * sd
isBull = close > basis

fvbFlipGreen = isBull and not isBull[1]
fvbFlipRed   = not isBull and isBull[1]

// ─── BXT ─────────────────────────────────────────────────────────────
emaDiff      = ta.ema(close, shortFast) - ta.ema(close, shortSlow)
shortBxt     = ta.rsi(emaDiff, shortRsi) - 50
longBxt      = ta.wma(ta.rsi(close, longRsi) - 50, smoothLen)
shortSmooth  = ta.wma(shortBxt, smoothLen)

bxtFlipGreen = shortBxt > 0 and shortBxt[1] <= 0
bxtFlipRed   = shortBxt < 0 and shortBxt[1] >= 0
xoverUp      = ta.crossover (shortSmooth, longBxt)
xoverDown    = ta.crossunder(shortSmooth, longBxt)

dualGreen = fvbFlipGreen and bxtFlipGreen
dualRed   = fvbFlipRed   and bxtFlipRed

// ─── REGIME ALIGNMENT (used for table + bg tint) ─────────────────────
fvbDir = isBull ? 1 : -1
bxtDir = shortBxt >= 0 ? 1 : -1
aligned   = fvbDir == bxtDir
regimeStr = aligned ? (isBull ? "BULL" : "BEAR") : "MIXED"
regimeCol = aligned ? (isBull ? bullCol : bearCol) : amberCol

// ─── PRICE PANE PLOTS ───────────────────────────────────────────────
// Bands take a regime tint at modest opacity — visible without being loud
bandTint = isBull ? color.new(bullCol, 40) : color.new(bearCol, 40)
upperPlot = plot(showBands ? upper : na, "Upper", color = bandTint, linewidth = 1, force_overlay = true)
lowerPlot = plot(showBands ? lower : na, "Lower", color = bandTint, linewidth = 1, force_overlay = true)

// Cloud — denser than v1 (60 instead of 80 transparency)
cloudCol = isBull ? color.new(bullCol, 65) : color.new(bearCol, 65)
fill(upperPlot, lowerPlot, color = showCloud ? cloudCol : na, title = "Cloud")

// Basis with soft halo (two stacked plots = visual weight without 1px hairline look)
plot(basis, "Basis halo", color = color.new(basisCol, 70), linewidth = 4, force_overlay = true)
plot(basis, "Basis",      color = basisCol,                linewidth = 2, force_overlay = true)

// Subtle bar coloring (off by default)
barcolor(colorBars ? (isBull ? color.new(bullCol, 70) : color.new(bearCol, 70)) : na)

// Flip dots ON the basis line (TV-style)
plotshape(showFlips and fvbFlipGreen ? basis : na, "FVB Bull Flip", shape.circle,
          location.absolute, color = bullCol, size = size.small, force_overlay = true)
plotshape(showFlips and fvbFlipRed   ? basis : na, "FVB Bear Flip", shape.circle,
          location.absolute, color = bearCol, size = size.small, force_overlay = true)

// DUAL FLIP triangles — the headline signal
plotshape(showDual and dualGreen ? low  : na, "DUAL ▲", shape.labelup,
          location.belowbar, color = bullCol, textcolor = color.white, text = "DUAL",
          size = size.small, force_overlay = true)
plotshape(showDual and dualRed   ? high : na, "DUAL ▼", shape.labeldown,
          location.abovebar, color = bearCol, textcolor = color.white, text = "DUAL",
          size = size.small, force_overlay = true)

// ─── OSCILLATOR PANE (BXT) ──────────────────────────────────────────
// Pane background tint based on combined regime
bgcolor(showBgPane ? color.new(regimeCol, 92) : na, title = "Pane bg")

// Histogram — saturated (was too transparent in v1)
histCol = shortBxt >= 0 ? color.new(bullCol, 25) : color.new(bearCol, 25)
plot(shortBxt, "BXT Short Hist", color = histCol, style = plot.style_columns)

// Smoothed lines — bolder, with halo
plot(shortSmooth, "Smooth Short halo", color = color.new(bullCol, 70), linewidth = 4)
plot(shortSmooth, "Smooth Short",       color = bullCol,                linewidth = 2)
plot(longBxt,     "Smooth Long halo",   color = color.new(bearCol, 70), linewidth = 4)
plot(longBxt,     "Smooth Long",        color = bearCol,                linewidth = 2)

// Reference levels
hline( 0,  "Zero", color = color.new(color.gray, 30), linestyle = hline.style_solid)
hline( 10, "+10",  color = color.new(color.gray, 70), linestyle = hline.style_dotted)
hline(-10, "−10",  color = color.new(color.gray, 70), linestyle = hline.style_dotted)

// Zero-cross flips
plotshape(showFlips and bxtFlipGreen ? 0 : na, "BXT Bull Flip", shape.circle,
          location.absolute, color = bullCol, size = size.small)
plotshape(showFlips and bxtFlipRed   ? 0 : na, "BXT Bear Flip", shape.circle,
          location.absolute, color = bearCol, size = size.small)

// Smoothed crossovers (more conservative confirmations)
plotshape(showXover and xoverUp   ? shortSmooth : na, "X-Up",   shape.diamond,
          location.absolute, color = bullCol, size = size.tiny)
plotshape(showXover and xoverDown ? shortSmooth : na, "X-Down", shape.diamond,
          location.absolute, color = bearCol, size = size.tiny)

// ─── STATUS TABLE (clean, mono, big text) ───────────────────────────
if showTable and barstate.islast
    var table tbl = table.new(position.top_right, 3, 4,
        bgcolor = color.new(color.black, 80),
        border_color = color.new(color.gray, 70), border_width = 1,
        frame_color = color.new(color.gray, 70), frame_width = 1)

    // Headers
    table.cell(tbl, 0, 0, "",      bgcolor = color.new(color.black, 60))
    table.cell(tbl, 1, 0, " FVB ", text_color = color.gray, text_size = size.normal,
               text_halign = text.align_center, bgcolor = color.new(color.black, 60))
    table.cell(tbl, 2, 0, " BXT ", text_color = color.gray, text_size = size.normal,
               text_halign = text.align_center, bgcolor = color.new(color.black, 60))

    // Regime row — color-filled cells
    table.cell(tbl, 0, 1, " REGIME ", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 1, isBull ? " BULL " : " BEAR ",
               text_color = color.white, text_size = size.normal, text_halign = text.align_center,
               bgcolor = isBull ? bullCol : bearCol)
    table.cell(tbl, 2, 1, shortBxt >= 0 ? " BULL " : " BEAR ",
               text_color = color.white, text_size = size.normal, text_halign = text.align_center,
               bgcolor = shortBxt >= 0 ? bullCol : bearCol)

    // Numerical values
    table.cell(tbl, 0, 2, " VALUE ", text_color = color.gray, text_size = size.small)
    fvbDelta = ((close - basis) / basis) * 100
    table.cell(tbl, 1, 2, " " + str.tostring(fvbDelta, "+#.##") + "% ",
               text_color = isBull ? bullCol : bearCol, text_size = size.normal,
               text_halign = text.align_right)
    table.cell(tbl, 2, 2, " " + str.tostring(shortBxt, "+#.##") + " ",
               text_color = shortBxt >= 0 ? bullCol : bearCol, text_size = size.normal,
               text_halign = text.align_right)

    // Combined dual-state row
    table.cell(tbl, 0, 3, " DUAL ", text_color = color.gray, text_size = size.small)
    dualText = dualGreen ? "▲ FLIP GREEN" : dualRed ? "▼ FLIP RED" : aligned ? (isBull ? "ALIGNED ▲" : "ALIGNED ▼") : "MIXED"
    dualBg   = dualGreen ? bullCol : dualRed ? bearCol : aligned ? color.new(regimeCol, 60) : color.new(amberCol, 50)
    table.cell(tbl, 1, 3, " " + dualText + " ", text_color = color.white, text_size = size.normal,
               text_halign = text.align_center, bgcolor = dualBg)
    table.cell(tbl, 2, 3, "", bgcolor = color.new(color.black, 80))

// ─── ALERTS ─────────────────────────────────────────────────────────
alertcondition(fvbFlipGreen, "FVB flipped GREEN",
    "{{ticker}} ({{interval}}) — FVB flipped GREEN at {{close}}")
alertcondition(fvbFlipRed,   "FVB flipped RED",
    "{{ticker}} ({{interval}}) — FVB flipped RED at {{close}}")
alertcondition(bxtFlipGreen, "BXT crossed above zero",
    "{{ticker}} ({{interval}}) — BXT crossed above zero at {{close}}")
alertcondition(bxtFlipRed,   "BXT crossed below zero",
    "{{ticker}} ({{interval}}) — BXT crossed below zero at {{close}}")
alertcondition(dualGreen, "DUAL FLIP GREEN (headline signal)",
    "{{ticker}} ({{interval}}) — DUAL FLIP GREEN: FVB and BXT both bullish at {{close}}")
alertcondition(dualRed, "DUAL FLIP RED (headline signal)",
    "{{ticker}} ({{interval}}) — DUAL FLIP RED: FVB and BXT both bearish at {{close}}")
alertcondition(xoverUp,   "BXT smoothed cross UP",
    "{{ticker}} ({{interval}}) — BXT smooth-short crossed above smooth-long at {{close}}")
alertcondition(xoverDown, "BXT smoothed cross DOWN",
    "{{ticker}} ({{interval}}) — BXT smooth-short crossed below smooth-long at {{close}}")
