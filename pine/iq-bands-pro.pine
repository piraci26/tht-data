// =============================================================================
// trend-iq · IQ Bands Pro  (full backtest stats table — mirrors reference layout)
// =============================================================================
//@version=6
indicator("trend-iq · IQ Bands Pro", "IQ Bands Pro", overlay = true, format = format.price, precision = 2, max_labels_count = 500, max_boxes_count = 500)

// ─── INPUTS ──────────────────────────────────────────────────────────
fvbLen     = input.int(33,  "IQ Bands Length",            minval = 2,   group = "IQ Bands")
fvbMult    = input.float(2.0, "IQ Bands StdDev Multiplier (outer)", minval = 0.0, step = 0.1, group = "IQ Bands")
threshMult = input.float(0.25, "Threshold (inner cloud σ — flip trigger)", minval = 0.0, step = 0.05, group = "IQ Bands")
basisSrc   = input.source(ohlc4, "Basis source", group = "IQ Bands")

shortFast = input.int(5,  "Short EMA fast",   minval = 1, group = "IQ Oscillator (alignment detection)")
shortSlow = input.int(20, "Short EMA slow",   minval = 1, group = "IQ Oscillator (alignment detection)")
shortRsi  = input.int(5,  "Short RSI length", minval = 1, group = "IQ Oscillator (alignment detection)")

tpPct = input.float(2.0, "TP threshold (%)", minval = 0.1, step = 0.1, group = "Backtest")
slPct = input.float(1.0, "SL threshold (%)", minval = 0.1, step = 0.1, group = "Backtest")

showCloud  = input.bool(true,  "Bands cloud (regime fill)", group = "Display")
showBands  = input.bool(true,  "Band edges with halo",      group = "Display")
showTable  = input.bool(true,  "Main stats table",          group = "Display")
showCard   = input.bool(true,  "Current trade card",        group = "Display")

bullCol  = input.color(#2EE89F, "Bull regime",  group = "Colors")
bearCol  = input.color(#FF6B6B, "Bear regime",  group = "Colors")
basisCol = input.color(#00E676, "Basis line",   group = "Colors")
amberCol = input.color(#FFAA00, "Mixed/warning",group = "Colors")

// ─── IQ BANDS ────────────────────────────────────────────────────────
basis        = ta.sma(basisSrc, fvbLen)
sd           = ta.stdev(close, fvbLen)
upper        = basis + fvbMult * sd
lower        = basis - fvbMult * sd
threshUpper  = basis + threshMult * sd
threshLower  = basis - threshMult * sd

var bool isBull       = false
var bool initialized  = false
if not initialized
    isBull       := close > basis
    initialized  := true
else if close > threshUpper
    isBull := true
else if close < threshLower
    isBull := false

prevIsBull = bool(isBull[1])
bandsFlipGreen = isBull and not prevIsBull
bandsFlipRed   = not isBull and prevIsBull

// ─── IQ OSCILLATOR (for alignment detection) ─────
emaDiff   = ta.ema(close, shortFast) - ta.ema(close, shortSlow)
shortBxt  = ta.rsi(emaDiff, shortRsi) - 50
oscFlipGreen = shortBxt > 0 and shortBxt[1] <= 0
oscFlipRed   = shortBxt < 0 and shortBxt[1] >= 0
dualGreen = bandsFlipGreen and oscFlipGreen
dualRed   = bandsFlipRed   and oscFlipRed
aligned   = isBull == (shortBxt >= 0)

// ─── MULTI-TF: 33 FVB (current TF), Wk BX, Mo BX structure ───────────
wkBxt = request.security(syminfo.tickerid, "W", shortBxt, lookahead = barmerge.lookahead_off)
moBxt = request.security(syminfo.tickerid, "M", shortBxt, lookahead = barmerge.lookahead_off)

// Structure: HH/HL/LH/LL based on current vs previous TF value
bxStructure(float v, float v1) =>
    v > v1 and v > 0  ? "HH" :
    v > v1 and v < 0  ? "HL" :
    v < v1 and v > 0  ? "LH" :
    v < v1 and v < 0  ? "LL" :
                        "—"

wkStruct = bxStructure(wkBxt, wkBxt[1])
moStruct = bxStructure(moBxt, moBxt[1])

// "33 FVB" = current TF bands regime (Bullish / Bearish)
fvbState = isBull ? "Bullish" : "Bearish"

// ─── BANDS WITH HALOS ───────────────────────────────────────────────
bandColor = isBull ? bullCol : bearCol
upperHalo = plot(showBands ? upper : na, "Upper halo", color = color.new(bandColor, 70), linewidth = 4, display = display.pane)
upperLine = plot(showBands ? upper : na, "Upper",      color = bandColor,                 linewidth = 2)
lowerHalo = plot(showBands ? lower : na, "Lower halo", color = color.new(bandColor, 70), linewidth = 4, display = display.pane)
lowerLine = plot(showBands ? lower : na, "Lower",      color = bandColor,                 linewidth = 2)
threshUpperPlot = plot(showBands ? threshUpper : na, "Threshold upper", color = color.new(bandColor, 50), linewidth = 1)
threshLowerPlot = plot(showBands ? threshLower : na, "Threshold lower", color = color.new(bandColor, 50), linewidth = 1)
cloudCol       = isBull ? color.new(bullCol, 78) : color.new(bearCol, 78)
threshCloudCol = isBull ? color.new(bullCol, 60) : color.new(bearCol, 60)
fill(upperLine, lowerLine, color = showCloud ? cloudCol : na, title = "Outer cloud")
fill(threshUpperPlot, threshLowerPlot, color = showCloud ? threshCloudCol : na, title = "Threshold cloud")
plot(basis, "Basis halo", color = color.new(basisCol, 70), linewidth = 4, display = display.pane)
plot(basis, "Basis",      color = basisCol,                linewidth = 2)

// ─── ALERTS ─────────────────────────────────────────────────────────
alertcondition(bandsFlipGreen, "IQ Bands flipped GREEN",
    "{{ticker}} ({{interval}}) — IQ Bands flipped GREEN at {{close}}")
alertcondition(bandsFlipRed,   "IQ Bands flipped RED",
    "{{ticker}} ({{interval}}) — IQ Bands flipped RED at {{close}}")
alertcondition(dualGreen, "BUY (dual flip green)",
    "{{ticker}} ({{interval}}) — BUY: IQ Bands and IQ Oscillator both flipped bullish at {{close}}")
alertcondition(dualRed, "SELL (dual flip red)",
    "{{ticker}} ({{interval}}) — SELL: IQ Bands and IQ Oscillator both flipped bearish at {{close}}")

// =============================================================================
// BACKTEST: track each flip as a trade
// =============================================================================
var array<float> tradePnls       = array.new<float>()
var array<int>   tradeBarsHeld   = array.new<int>()
var array<float> tradePullbacks  = array.new<float>()
var array<int>   tradeBarsToLow  = array.new<int>()
var array<bool>  tradeAligned    = array.new<bool>()
var array<int>   tradeTpSlClass  = array.new<int>()

var float entryPrice  = na
var int   entryBar    = na
var bool  inLong      = false
var bool  inShort     = false
var float maxAdverse  = 0.0
var int   maxAdvBar   = na
var bool  alignAtEntry = false
var int   barsInMkt   = 0

if inLong or inShort
    barsInMkt := barsInMkt + 1

if inLong and not na(entryPrice)
    adv = (low - entryPrice) / entryPrice * 100
    if adv < maxAdverse
        maxAdverse := adv
        maxAdvBar  := bar_index
if inShort and not na(entryPrice)
    adv = (entryPrice - high) / entryPrice * 100
    if adv < maxAdverse
        maxAdverse := adv
        maxAdvBar  := bar_index

closeTrade(float pnl, int bh, float pb, int btl, bool wasAln) =>
    array.push(tradePnls, pnl)
    array.push(tradeBarsHeld, bh)
    array.push(tradePullbacks, pb)
    array.push(tradeBarsToLow, btl)
    array.push(tradeAligned, wasAln)
    cls = pnl >= tpPct ? 1 : pnl <= -slPct ? -1 : 0
    array.push(tradeTpSlClass, cls)

if bandsFlipGreen and barstate.isconfirmed
    if inShort and not na(entryPrice)
        pnl = (entryPrice - close) / entryPrice * 100
        bh  = bar_index - entryBar
        btl = na(maxAdvBar) ? 0 : maxAdvBar - entryBar
        closeTrade(pnl, bh, maxAdverse, btl, alignAtEntry)
    inShort := false
    inLong  := true
    entryPrice   := close
    entryBar     := bar_index
    maxAdverse   := 0.0
    maxAdvBar    := bar_index
    alignAtEntry := oscFlipGreen or shortBxt > 0

if bandsFlipRed and barstate.isconfirmed
    if inLong and not na(entryPrice)
        pnl = (close - entryPrice) / entryPrice * 100
        bh  = bar_index - entryBar
        btl = na(maxAdvBar) ? 0 : maxAdvBar - entryBar
        closeTrade(pnl, bh, maxAdverse, btl, alignAtEntry)
    inLong  := false
    inShort := true
    entryPrice   := close
    entryBar     := bar_index
    maxAdverse   := 0.0
    maxAdvBar    := bar_index
    alignAtEntry := oscFlipRed or shortBxt < 0

totalTrades = array.size(tradePnls)

// Re-Entry state: "Armed" if flat OR in a trade older than 5 bars, else "Active"
reEntryState = (not inLong and not inShort) or (bar_index - entryBar > 5) ? "Armed" : "Active"
reEntryArmed = reEntryState == "Armed"

// =============================================================================
// TABLE
// =============================================================================
if barstate.islast and showTable
    // ── Aggregate: 3 splits — ALL, ENTRY (aligned), RE-ENTRY (unaligned)
    int   wA = 0, lA = 0, tpA = 0, slA = 0, sumHoldA = 0, sumBtlA = 0
    float twA = 0.0, tlA = 0.0, cumA = 1.0, sumPullA = 0.0
    int   wE = 0, lE = 0, tpE = 0, slE = 0, sumHoldE = 0, sumBtlE = 0, countE = 0
    float twE = 0.0, tlE = 0.0, cumE = 1.0, sumPullE = 0.0
    int   wR = 0, lR = 0, tpR = 0, slR = 0, sumHoldR = 0, sumBtlR = 0, countR = 0
    float twR = 0.0, tlR = 0.0, cumR = 1.0, sumPullR = 0.0

    if totalTrades > 0
        for i = 0 to totalTrades - 1
            p = array.get(tradePnls, i)
            bh = array.get(tradeBarsHeld, i)
            pb = array.get(tradePullbacks, i)
            btl = array.get(tradeBarsToLow, i)
            cls = array.get(tradeTpSlClass, i)
            wasAln = array.get(tradeAligned, i)
            // ALL
            if p > 0
                wA := wA + 1
                twA := twA + p
            else if p < 0
                lA := lA + 1
                tlA := tlA + math.abs(p)
            cumA := cumA * (1 + p / 100)
            sumHoldA := sumHoldA + bh
            sumPullA := sumPullA + pb
            sumBtlA  := sumBtlA + btl
            if cls == 1
                tpA := tpA + 1
            else if cls == -1
                slA := slA + 1
            // ENTRY (aligned)
            if wasAln
                countE := countE + 1
                if p > 0
                    wE := wE + 1
                    twE := twE + p
                else if p < 0
                    lE := lE + 1
                    tlE := tlE + math.abs(p)
                cumE := cumE * (1 + p / 100)
                sumHoldE := sumHoldE + bh
                sumPullE := sumPullE + pb
                sumBtlE  := sumBtlE + btl
                if cls == 1
                    tpE := tpE + 1
                else if cls == -1
                    slE := slE + 1
            // RE-ENTRY (unaligned)
            else
                countR := countR + 1
                if p > 0
                    wR := wR + 1
                    twR := twR + p
                else if p < 0
                    lR := lR + 1
                    tlR := tlR + math.abs(p)
                cumR := cumR * (1 + p / 100)
                sumHoldR := sumHoldR + bh
                sumPullR := sumPullR + pb
                sumBtlR  := sumBtlR + btl
                if cls == 1
                    tpR := tpR + 1
                else if cls == -1
                    slR := slR + 1

    // Derived per column
    accA = totalTrades > 0 ? wA / float(totalTrades) * 100 : 0.0
    accE = countE > 0 ? wE / float(countE) * 100 : 0.0
    accR = countR > 0 ? wR / float(countR) * 100 : 0.0
    awA = wA > 0 ? twA / wA : 0.0
    alA = lA > 0 ? tlA / lA : 0.0
    awE = wE > 0 ? twE / wE : 0.0
    alE = lE > 0 ? tlE / lE : 0.0
    awR = wR > 0 ? twR / wR : 0.0
    alR = lR > 0 ? tlR / lR : 0.0
    rvrA = alA > 0 ? awA / alA : na
    rvrE = alE > 0 ? awE / alE : na
    rvrR = alR > 0 ? awR / alR : na
    pfA = tlA > 0 ? twA / tlA : na
    pfE = tlE > 0 ? twE / tlE : na
    pfR = tlR > 0 ? twR / tlR : na
    retA = (cumA - 1) * 100
    retE = (cumE - 1) * 100
    retR = (cumR - 1) * 100
    holdA = totalTrades > 0 ? sumHoldA / float(totalTrades) : 0.0
    holdE = countE > 0 ? sumHoldE / float(countE) : 0.0
    holdR = countR > 0 ? sumHoldR / float(countR) : 0.0
    pullA = totalTrades > 0 ? sumPullA / float(totalTrades) : 0.0
    pullE = countE > 0 ? sumPullE / float(countE) : 0.0
    pullR = countR > 0 ? sumPullR / float(countR) : 0.0
    btlA = totalTrades > 0 ? sumBtlA / float(totalTrades) : 0.0
    btlE = countE > 0 ? sumBtlE / float(countE) : 0.0
    btlR = countR > 0 ? sumBtlR / float(countR) : 0.0
    timeMkt = bar_index > 0 ? barsInMkt / float(bar_index) * 100 : 0.0
    capEff = timeMkt > 0 ? retA / (timeMkt / 100) : na

    // ── MAIN TABLE — 4 cols × 24 rows, top_right
    var table tbl = table.new(position.top_right, 4, 24,
        bgcolor      = color.new(color.black, 80),
        border_color = color.new(color.gray, 70), border_width = 1,
        frame_color  = color.new(color.gray, 70), frame_width  = 1)

    hdrBg = color.new(color.black, 60)
    txtSm = size.small

    // Row 0 — column headers
    table.cell(tbl, 0, 0, " WARRANT ",         text_color = color.gray, text_size = txtSm, bgcolor = hdrBg)
    table.cell(tbl, 1, 0, " NBX ",             text_color = color.gray, text_size = txtSm, text_halign = text.align_center, bgcolor = hdrBg)
    table.cell(tbl, 2, 0, " Combined Signal ", text_color = color.gray, text_size = txtSm, text_halign = text.align_center, bgcolor = hdrBg)
    table.cell(tbl, 3, 0, " System ",          text_color = color.gray, text_size = txtSm, text_halign = text.align_center, bgcolor = hdrBg)

    // Row 1: FVBLen | 33 | | |
    table.cell(tbl, 0, 1, " FVBLen ",  text_color = color.gray, text_size = txtSm)
    table.cell(tbl, 1, 1, " " + str.tostring(fvbLen) + " ", text_color = color.white, text_halign = text.align_center)
    table.cell(tbl, 2, 1, "")
    table.cell(tbl, 3, 1, "")

    // Row 2: Entry | FVB
    table.cell(tbl, 0, 2, " Entry ",   text_color = color.gray, text_size = txtSm)
    table.cell(tbl, 1, 2, " FVB ",     text_color = color.white, text_halign = text.align_center)
    table.cell(tbl, 2, 2, "")
    table.cell(tbl, 3, 2, "")

    // Row 3: SL Src | MoBX
    table.cell(tbl, 0, 3, " SL Src ",  text_color = color.gray, text_size = txtSm)
    table.cell(tbl, 1, 3, " MoBX ",    text_color = color.white, text_halign = text.align_center)
    table.cell(tbl, 2, 3, "")
    table.cell(tbl, 3, 3, "")

    // Row 4: CONDITIONS header
    table.cell(tbl, 0, 4, " CONDITIONS ", text_color = color.gray, text_size = txtSm, bgcolor = hdrBg)
    table.cell(tbl, 1, 4, "", bgcolor = hdrBg)
    table.cell(tbl, 2, 4, "", bgcolor = hdrBg)
    table.cell(tbl, 3, 4, "", bgcolor = hdrBg)

    // Row 5: 33 FVB | Bullish/Bearish
    table.cell(tbl, 0, 5, " 33 FVB ",  text_color = color.gray, text_size = txtSm)
    table.cell(tbl, 1, 5, " " + fvbState + " ",
               text_color = color.white, text_halign = text.align_center,
               bgcolor = isBull ? color.new(bullCol, 40) : color.new(bearCol, 40))
    table.cell(tbl, 2, 5, "")
    table.cell(tbl, 3, 5, "")

    // Row 6: Wk BX | structure (HH/HL/LH/LL)
    wkCol = wkStruct == "HH" or wkStruct == "HL" ? color.new(bullCol, 40) :
            wkStruct == "LH" or wkStruct == "LL" ? color.new(bearCol, 40) : color.new(color.gray, 60)
    table.cell(tbl, 0, 6, " Wk BX ",   text_color = color.gray, text_size = txtSm)
    table.cell(tbl, 1, 6, " " + wkStruct + " ",
               text_color = color.white, text_halign = text.align_center, bgcolor = wkCol)
    table.cell(tbl, 2, 6, "")
    table.cell(tbl, 3, 6, "")

    // Row 7: Mo BX | structure
    moCol = moStruct == "HH" or moStruct == "HL" ? color.new(bullCol, 40) :
            moStruct == "LH" or moStruct == "LL" ? color.new(bearCol, 40) : color.new(color.gray, 60)
    table.cell(tbl, 0, 7, " Mo BX ",   text_color = color.gray, text_size = txtSm)
    table.cell(tbl, 1, 7, " " + moStruct + " ",
               text_color = color.white, text_halign = text.align_center, bgcolor = moCol)
    table.cell(tbl, 2, 7, "")
    table.cell(tbl, 3, 7, "")

    // Row 8: Re-Entry | Armed/Active
    table.cell(tbl, 0, 8, " Re-Entry ", text_color = color.gray, text_size = txtSm)
    table.cell(tbl, 1, 8, " " + reEntryState + " ",
               text_color = color.white, text_halign = text.align_center,
               bgcolor = reEntryArmed ? color.new(bullCol, 40) : color.new(amberCol, 50))
    table.cell(tbl, 2, 8, "")
    table.cell(tbl, 3, 8, "")

    // Row 9: OVERALL STATS header (col 0) | (blank, col 1) | ENTRY STATS (col 2) | RE-ENTRY STATS (col 3)
    table.cell(tbl, 0, 9, " OVERALL STATS ", text_color = color.gray, text_size = txtSm, bgcolor = hdrBg)
    table.cell(tbl, 1, 9, "", bgcolor = hdrBg)
    table.cell(tbl, 2, 9, " ENTRY STATS ",   text_color = color.gray, text_size = txtSm, text_halign = text.align_center, bgcolor = hdrBg)
    table.cell(tbl, 3, 9, " RE-ENTRY STATS ",text_color = color.gray, text_size = txtSm, text_halign = text.align_center, bgcolor = hdrBg)

    // Helpers
    accColor(float acc, int n) =>
        n == 0 ? color.gray : acc >= 60 ? bullCol : acc >= 50 ? amberCol : bearCol

    // Row 10: ACCURACY
    table.cell(tbl, 0, 10, " ACCURACY ", text_color = color.gray, text_size = txtSm)
    table.cell(tbl, 1, 10, totalTrades == 0 ? " — " : " " + str.tostring(accA, "#.#") + "% ",
               text_color = accColor(accA, totalTrades), text_halign = text.align_center,
               bgcolor = color.new(accColor(accA, totalTrades), 70))
    table.cell(tbl, 2, 10, countE == 0 ? " — " : " " + str.tostring(accE, "#.#") + "% ",
               text_color = accColor(accE, countE), text_halign = text.align_center,
               bgcolor = color.new(accColor(accE, countE), 70))
    table.cell(tbl, 3, 10, countR == 0 ? " — " : " " + str.tostring(accR, "#.#") + "% ",
               text_color = accColor(accR, countR), text_halign = text.align_center,
               bgcolor = color.new(accColor(accR, countR), 70))

    // Row 11: W/L
    table.cell(tbl, 0, 11, " W/L ", text_color = color.gray, text_size = txtSm)
    table.cell(tbl, 1, 11, " " + str.tostring(wA) + "W/" + str.tostring(lA) + "L ", text_color = color.white, text_halign = text.align_center)
    table.cell(tbl, 2, 11, " " + str.tostring(wE) + "W/" + str.tostring(lE) + "L ", text_color = color.white, text_halign = text.align_center)
    table.cell(tbl, 3, 11, " " + str.tostring(wR) + "W/" + str.tostring(lR) + "L ", text_color = color.white, text_halign = text.align_center)

    // Row 12: TP/SL
    table.cell(tbl, 0, 12, " TP/SL ", text_color = color.gray, text_size = txtSm)
    table.cell(tbl, 1, 12, " " + str.tostring(tpA) + "TP/" + str.tostring(slA) + "SL ", text_color = color.white, text_halign = text.align_center)
    table.cell(tbl, 2, 12, " " + str.tostring(tpE) + "TP/" + str.tostring(slE) + "SL ", text_color = color.white, text_halign = text.align_center)
    table.cell(tbl, 3, 12, " " + str.tostring(tpR) + "TP/" + str.tostring(slR) + "SL ", text_color = color.white, text_halign = text.align_center)

    // Row 13: Avg LOSS
    table.cell(tbl, 0, 13, " Avg LOSS ", text_color = color.gray, text_size = txtSm)
    table.cell(tbl, 1, 13, lA == 0 ? " — " : " -" + str.tostring(alA, "#.#") + "% ", text_color = bearCol, text_halign = text.align_right)
    table.cell(tbl, 2, 13, lE == 0 ? " — " : " -" + str.tostring(alE, "#.#") + "% ", text_color = bearCol, text_halign = text.align_right)
    table.cell(tbl, 3, 13, lR == 0 ? " — " : " -" + str.tostring(alR, "#.#") + "% ", text_color = bearCol, text_halign = text.align_right)

    // Row 14: Avg WIN
    table.cell(tbl, 0, 14, " Avg WIN ", text_color = color.gray, text_size = txtSm)
    table.cell(tbl, 1, 14, wA == 0 ? " — " : " +" + str.tostring(awA, "#.#") + "% ", text_color = bullCol, text_halign = text.align_right)
    table.cell(tbl, 2, 14, wE == 0 ? " — " : " +" + str.tostring(awE, "#.#") + "% ", text_color = bullCol, text_halign = text.align_right)
    table.cell(tbl, 3, 14, wR == 0 ? " — " : " +" + str.tostring(awR, "#.#") + "% ", text_color = bullCol, text_halign = text.align_right)

    // Row 15: RVR
    table.cell(tbl, 0, 15, " RVR ", text_color = color.gray, text_size = txtSm)
    table.cell(tbl, 1, 15, na(rvrA) ? " — " : " " + str.tostring(rvrA, "#.##") + ":1 ", text_color = color.white, text_halign = text.align_right)
    table.cell(tbl, 2, 15, na(rvrE) ? " — " : " " + str.tostring(rvrE, "#.##") + ":1 ", text_color = color.white, text_halign = text.align_right)
    table.cell(tbl, 3, 15, na(rvrR) ? " — " : " " + str.tostring(rvrR, "#.##") + ":1 ", text_color = color.white, text_halign = text.align_right)

    // Row 16: Return
    table.cell(tbl, 0, 16, " Return ", text_color = color.gray, text_size = txtSm)
    table.cell(tbl, 1, 16, totalTrades == 0 ? " — " : " " + str.tostring(retA, "+#.##") + "% ", text_color = retA >= 0 ? bullCol : bearCol, text_halign = text.align_right)
    table.cell(tbl, 2, 16, countE == 0 ? " — " : " " + str.tostring(retE, "+#.##") + "% ", text_color = retE >= 0 ? bullCol : bearCol, text_halign = text.align_right)
    table.cell(tbl, 3, 16, countR == 0 ? " — " : " " + str.tostring(retR, "+#.##") + "% ", text_color = retR >= 0 ? bullCol : bearCol, text_halign = text.align_right)

    // Row 17: Prof.Factor
    table.cell(tbl, 0, 17, " Prof.Factor ", text_color = color.gray, text_size = txtSm)
    table.cell(tbl, 1, 17, na(pfA) ? " — " : " " + str.tostring(pfA, "#.##") + " ", text_color = color.white, text_halign = text.align_right)
    table.cell(tbl, 2, 17, na(pfE) ? " — " : " " + str.tostring(pfE, "#.##") + " ", text_color = color.white, text_halign = text.align_right)
    table.cell(tbl, 3, 17, na(pfR) ? " — " : " " + str.tostring(pfR, "#.##") + " ", text_color = color.white, text_halign = text.align_right)

    // Row 18: Avg Hold
    table.cell(tbl, 0, 18, " Avg Hold ", text_color = color.gray, text_size = txtSm)
    table.cell(tbl, 1, 18, totalTrades == 0 ? " — " : " " + str.tostring(math.round(holdA)) + " bars ", text_color = color.white, text_halign = text.align_right)
    table.cell(tbl, 2, 18, countE == 0 ? " — " : " " + str.tostring(math.round(holdE)) + " bars ", text_color = color.white, text_halign = text.align_right)
    table.cell(tbl, 3, 18, countR == 0 ? " — " : " " + str.tostring(math.round(holdR)) + " bars ", text_color = color.white, text_halign = text.align_right)

    // Row 19: Pullback
    table.cell(tbl, 0, 19, " Pullback ", text_color = color.gray, text_size = txtSm)
    table.cell(tbl, 1, 19, totalTrades == 0 ? " — " : " " + str.tostring(pullA, "#.##") + "% ", text_color = bearCol, text_halign = text.align_right)
    table.cell(tbl, 2, 19, countE == 0 ? " — " : " " + str.tostring(pullE, "#.##") + "% ", text_color = bearCol, text_halign = text.align_right)
    table.cell(tbl, 3, 19, countR == 0 ? " — " : " " + str.tostring(pullR, "#.##") + "% ", text_color = bearCol, text_halign = text.align_right)

    // Row 20: Bars to Low
    table.cell(tbl, 0, 20, " Bars to Low ", text_color = color.gray, text_size = txtSm)
    table.cell(tbl, 1, 20, totalTrades == 0 ? " — " : " " + str.tostring(math.round(btlA)) + " bars ", text_color = color.white, text_halign = text.align_right)
    table.cell(tbl, 2, 20, countE == 0 ? " — " : " " + str.tostring(math.round(btlE)) + " bars ", text_color = color.white, text_halign = text.align_right)
    table.cell(tbl, 3, 20, countR == 0 ? " — " : " " + str.tostring(math.round(btlR)) + " bars ", text_color = color.white, text_halign = text.align_right)

    // Row 21: Time in Mkt (only col 1)
    table.cell(tbl, 0, 21, " Time in Mkt ", text_color = color.gray, text_size = txtSm)
    table.cell(tbl, 1, 21, " " + str.tostring(timeMkt, "#.#") + "% ", text_color = color.white, text_halign = text.align_right)
    table.cell(tbl, 2, 21, "")
    table.cell(tbl, 3, 21, "")

    // Row 22: Cap Eff (only col 1)
    table.cell(tbl, 0, 22, " Cap Eff ", text_color = color.gray, text_size = txtSm)
    table.cell(tbl, 1, 22, na(capEff) ? " — " : " " + str.tostring(capEff, "+#.#") + "% ",
               text_color = capEff >= 0 ? bullCol : bearCol, text_halign = text.align_right)
    table.cell(tbl, 2, 22, "")
    table.cell(tbl, 3, 22, "")

    // Row 23: (blank padding row)
    table.cell(tbl, 0, 23, "")
    table.cell(tbl, 1, 23, "")
    table.cell(tbl, 2, 23, "")
    table.cell(tbl, 3, 23, "")

// ─── SEPARATE CURRENT TRADE CARD (side, top-right adjacent area) ────
if barstate.islast and showCard
    curPnlPct = inLong and not na(entryPrice)  ? (close - entryPrice) / entryPrice * 100 :
                inShort and not na(entryPrice) ? (entryPrice - close) / entryPrice * 100 : 0.0
    curPnlAbs = (inLong or inShort) and not na(entryPrice) ? (curPnlPct / 100) * entryPrice : 0.0
    pnlCol = curPnlPct >= 0 ? bullCol : bearCol

    var table card = table.new(position.middle_right, 2, 3,
        bgcolor      = color.new(color.black, 80),
        border_color = color.new(color.gray, 70), border_width = 1,
        frame_color  = color.new(color.gray, 70), frame_width  = 1)

    // P&L $
    table.cell(card, 0, 0, " P&L $ ", text_color = color.gray, text_size = size.small)
    pnlAbsTxt = (inLong or inShort) ? " $" + str.tostring(curPnlAbs, "+#.##") + " " : " — "
    table.cell(card, 1, 0, pnlAbsTxt, text_color = pnlCol, text_halign = text.align_right,
               bgcolor = color.new(pnlCol, 70))

    // Entry Price
    table.cell(card, 0, 1, " Entry Price ", text_color = color.gray, text_size = size.small)
    entryTxt = na(entryPrice) ? " — " : " $" + str.tostring(entryPrice, "#.##") + " "
    table.cell(card, 1, 1, entryTxt, text_color = color.white, text_halign = text.align_right)

    // Current
    table.cell(card, 0, 2, " Current ", text_color = color.gray, text_size = size.small)
    table.cell(card, 1, 2, " $" + str.tostring(close, "#.##") + " ",
               text_color = color.white, text_halign = text.align_right)
